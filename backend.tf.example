# Copy to backend.tf and fill in this client's state bucket.
# Do not point this at another client's state key.

terraform {
  backend "s3" {
    bucket       = "YOUR-TFSTATE-BUCKET"
    key          = "env-start-stop/terraform.tfstate"
    region       = "us-east-1"
    encrypt      = true
    use_lockfile = true
  }
}
